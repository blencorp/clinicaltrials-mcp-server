[
  {
    "name": "search_api",
    "title": "Search ClinicalTrials.gov API surface",
    "description": "Search the ClinicalTrials.gov SDK surface (see https://clinicaltrials.gov/data-api/api). Returns a TypeScript snippet describing the most relevant endpoints and study fields for your query. Use this before writing code for `execute`.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "description": "What you are looking for, in plain words, e.g. 'recruiting studies by condition'"
        },
        "k": {
          "description": "Number of matches to return (default 8)",
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "snippet": {
          "type": "string",
          "description": "TypeScript reference and the matching endpoint/field notes"
        },
        "hits": {
          "type": "integer",
          "description": "How many endpoint/field matches the snippet contains"
        }
      },
      "required": [
        "query",
        "snippet",
        "hits"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "describe_schema",
    "title": "Describe ClinicalTrials.gov study fields",
    "description": "Return doc entries for study-data fields by exact `path` or by `prefix` (exactly one of them). Useful for discovering nested field names before projection. Field reference: https://clinicaltrials.gov/data-api/about-api/study-data-structure.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "description": "Exact dotted field path, e.g. 'protocolSection.identificationModule.nctId'",
          "type": "string"
        },
        "prefix": {
          "description": "Path prefix to enumerate, e.g. 'protocolSection.statusModule'",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "path"
          ],
          "not": {
            "required": [
              "prefix"
            ]
          }
        },
        {
          "required": [
            "prefix"
          ],
          "not": {
            "required": [
              "path"
            ]
          }
        }
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "matches": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "total": {
          "type": "integer"
        }
      },
      "required": [
        "matches",
        "total"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "execute",
    "title": "Execute sandboxed ClinicalTrials.gov query",
    "description": "Run a short async body against the `ctgov` SDK in a secure sandbox to query the public ClinicalTrials.gov v2 API (https://clinicaltrials.gov/data-api/api). The body is wrapped as `async (ctgov) => { <your code> }` and must `return` a JSON-serializable value. Read-only: the SDK only exposes GET endpoints. No network/fs; only `ctgov.*` methods, `console.*`, and standard globals are available.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "description": "JavaScript to run in the sandbox: the body of `async (ctgov) => { ... }`; `return` a JSON-serializable value"
        },
        "timeoutMs": {
          "description": "Wall-clock limit in milliseconds",
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "memoryMb": {
          "description": "Heap limit in MB (isolate sandbox only)",
          "type": "integer",
          "minimum": 16,
          "maximum": 256
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "description": "false when the code threw, timed out, or broke a limit; see error"
        },
        "result": {
          "description": "The JSON value the code returned"
        },
        "logs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "error": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "stack": {
              "type": "string"
            },
            "code": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "message"
          ]
        },
        "calls": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "durationMs": {
          "type": "number"
        },
        "executor": {
          "type": "string",
          "enum": [
            "isolate",
            "deno"
          ]
        }
      },
      "required": [
        "ok",
        "logs",
        "calls",
        "durationMs",
        "executor"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  }
]
