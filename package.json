{
  "name": "@blen/clinicaltrial-mcp-server",
  "version": "0.1.0-alpha.0",
  "description": "MCP server for ClinicalTrials.gov (by Blen). Unaffiliated with NIH/NLM.",
  "license": "MIT",
  "author": "Blen <opensource@blencorp.com>",
  "homepage": "https://github.com/blencorp/clinicaltrials-mcp-server",
  "repository": {
    "type": "git",
    "url": "https://github.com/blencorp/clinicaltrials-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/blencorp/clinicaltrials-mcp-server/issues",
    "email": "opensource@blencorp.com"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "clinicaltrials",
    "clinical-trials",
    "code-mode",
    "anthropic",
    "claude"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "clinicaltrial-mcp-server": "dist/bin.js"
  },
  "files": [
    "dist",
    "schema",
    "assets",
    "README.md",
    "LICENSE",
    "legal"
  ],
  "engines": {
    "node": "^24.11.0 || ^26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm build:web && (chmod +x dist/bin.js || true)",
    "dev": "tsx src/bin.ts",
    "start": "node dist/bin.js",
    "mcpb:prepare": "tsx scripts/mcpb.ts prepare",
    "mcpb:validate": "tsx scripts/mcpb.ts validate",
    "mcpb:pack": "tsx scripts/mcpb.ts pack",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p web/e2e/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "regen:sdk": "tsx scripts/regenerate-sdk.ts",
    "verify:schema": "tsx scripts/verify-pinned-schema.ts",
    "check:directory": "tsx scripts/check-directory-compliance.ts",
    "prepublishOnly": "pnpm build",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite build --watch --config web/vite.config.ts",
    "test:web": "pnpm build:web && playwright test",
    "kit:check": "node scripts/portal-kit.mjs",
    "kit:update": "node scripts/portal-kit.mjs --update"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.26",
    "@better-auth/mcp": "1.7.26",
    "@better-auth/oauth-provider": "1.7.26",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "better-auth": "1.7.26",
    "express": "5.3.0",
    "jose": "^6.2.18",
    "lru-cache": "^11.5.3",
    "pg": "8.23.1",
    "undici": "^8.13.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "isolated-vm": "^7.0.2"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/express": "5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fetch-cookie": "3.2.0",
    "globals": "^17.14.0",
    "lucide-react": "1.77.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "8.5.2",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "4.3.5",
    "tough-cookie": "6.1.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "8.3.8",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.21.0"
}
